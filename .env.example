# ---- Server ----
# Port the service listens on (Render/Fly/Railway inject this automatically).
PORT=3000
# Public HTTPS base URL of THIS deployed service. Twilio calls back to it, so it
# must be reachable from the internet. No trailing slash.
# e.g. https://call-me-connector.onrender.com
PUBLIC_URL=

# ---- Twilio ----
# From your Twilio Console dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# A Twilio phone number you own, in E.164 format. This is who the call comes FROM.
TWILIO_FROM_NUMBER=+15551234567

# ---- Who gets called ----
# YOUR personal cell, E.164. By default the connector will ONLY ever dial this
# number, no matter what the model passes — this is the anti-robocall guard.
USER_PHONE_NUMBER=+15559876543
# Set to true only if you want to allow the model to call other numbers via the
# tool's optional `to` argument. Leave false for a personal, single-number tool.
ALLOW_NUMBER_OVERRIDE=false

# ---- Plan tier ----
# "basic" = one-shot calls only. "pro" = also unlocks multi-turn conversation
# mode (the `conversational: true` tool argument). See README for pricing.
TIER=basic

# ---- Security: static token (simple, personal use) ----
# Optional shared secret. If set, /mcp accepts Authorization: Bearer <this value>.
# Fine for private use; still honored even when OAuth is on.
CONNECTOR_TOKEN=
# Verify that voice webhooks genuinely come from Twilio (recommended: true).
VALIDATE_TWILIO_SIGNATURE=true

# ---- Security: OAuth 2.1 (required for a PUBLIC store listing) ----
# OAuth auto-enables once BOTH of the next two are set. Force on/off with
# OAUTH_ENABLED=true|false.
# A long random secret used to sign access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OAUTH_SIGNING_SECRET=
# The code YOU type on the consent screen to approve a connection. Treat like a
# password. This is how the connector knows it's really you authorizing.
OWNER_ACCESS_CODE=
# OAUTH_ENABLED=true

# ---- Voice ----
# Any Twilio/Amazon Polly voice, e.g. Polly.Joanna, Polly.Matthew, Polly.Amy.
VOICE=Polly.Joanna
LANGUAGE=en-US
